# AutonomePay Backend Configuration

PROJECT_NAME=AutonomePay
API_V1_STR=/api

# Database Connection (Neon PostgreSQL serverless URL or local SQLite)
DATABASE_URL=sqlite:///./autonomepay.db

# OpenRouter Free / Gateway API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LiteLLM 4-Tier Preference & Fallback Chain
PRIMARY_MODEL=openrouter/minimax/minimax-m3:free
SECONDARY_MODEL=openrouter/minimax/minimax-m2.7:free
THIRD_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
FALLBACK_MODEL=openrouter/openrouter/free

# LangSmith Observability & Dataset Tracking
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=AutonomePay-RevenueRecovery

# Razorpay MCP API Keys (Live Test Keys)
RAZORPAY_KEY_ID=rzp_test_mock12345
RAZORPAY_KEY_SECRET=mock_secret_67890

# Token Spending Budget
MAX_SESSION_TOKEN_BUDGET=4000
