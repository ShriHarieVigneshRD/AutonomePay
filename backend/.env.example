# AutonomePay backend configuration. Copy to backend/.env and fill in what you need.
# Every value is optional: with nothing set the app runs fully offline (policy heuristic
# instead of the LLM, sandbox payment links, local SQLite).

LOG_LEVEL=INFO

# Database: local SQLite by default; any SQLAlchemy URL works (e.g. Neon/PostgreSQL).
DATABASE_URL=sqlite:///./autonomepay.db

# --- LLM (LiteLLM -> OpenRouter), tried in this order ------------------------------------
OPENROUTER_API_KEY=
PRIMARY_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
SECONDARY_MODEL=openrouter/google/gemma-4-31b-it:free
THIRD_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
FALLBACK_MODEL=openrouter/openrouter/free
LLM_MAX_TOKENS=800
# Token budget per conversation (each chat session id gets its own budget).
MAX_SESSION_TOKEN_BUDGET=20000

# --- Policy retrieval (RAG) -----------------------------------------------------------------
# bm25 = keywords only (~290 MB server); hybrid = + local embeddings (~555 MB);
# hybrid_rerank = + cross-encoder reranker (~700 MB). Models download once into MODEL_CACHE_DIR.
# Under 1 GB of container memory (e.g. Render free), bm25 is used whatever this says.
RAG_MODE=hybrid_rerank
RAG_TOP_K=3
RAG_THREADS=2
MODEL_CACHE_DIR=.cache/models

# --- Razorpay -------------------------------------------------------------------------------
# Test-mode keys (rzp_test_...) create real test payment links. Keys starting with
# rzp_test_mock (or empty) use the built-in sandbox.
RAZORPAY_KEY_ID=rzp_test_mock12345
RAZORPAY_KEY_SECRET=
# Let Razorpay SMS/email customers about links (only with real customer data; never the demo seed).
RAZORPAY_NOTIFY_CUSTOMERS=false
# Payment tools are called over MCP. embedded = AutonomePay's own MCP server in-process;
# remote = Razorpay's hosted MCP server (uses the keys above as Basic auth);
# stdio = launch an MCP server binary, e.g. RAZORPAY_MCP_COMMAND="razorpay-mcp-server stdio".
RAZORPAY_MCP_MODE=embedded
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
RAZORPAY_MCP_COMMAND=
# Where sandbox payment links point (the frontend's URL).
PUBLIC_APP_URL=http://localhost:5173

# --- Web & security -------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://autonome-pay.vercel.app
# If set, starting benchmark runs / LangSmith sync requires the X-Admin-Token header.
ADMIN_TOKEN=
# Chat requests allowed per client IP per minute.
CHAT_RATE_LIMIT_PER_MIN=30

# --- LangSmith (optional) ---------------------------------------------------------------
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AutonomePay-RevenueRecovery
